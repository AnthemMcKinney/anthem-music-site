---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const {
  title = "Anthem Music | Music Lessons in Downtown McKinney, TX",
  description = "Guitar, piano, violin, drums, and brass lessons for all ages in downtown McKinney. A family-centered music studio rooted in craft, mentorship, and real musicianship.",
  path = "",
  ogImage = "/images/og-card-v2.jpg",
} = Astro.props;

const site = "https://anthemmusic.net";
const canonical = site + path;
// Version query busts social/CDN caches when the card art changes.
// Bump this number any time an og image is updated.
const ogImageUrl = site + ogImage + "?v=2";
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="en_US" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImageUrl} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <!-- LocalBusiness structured data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": ["LocalBusiness", "EducationalOrganization"],
    "name": "Anthem Music LLC",
    // alternateName + sameAs tie this site to the Google Business Profile and social
    // accounts, which helps Google treat them as one entity.
    "alternateName": ["Anthem Music", "Anthem Music Studios"],
    "sameAs": [
      "https://www.facebook.com/anthemmusicstudios",
      "https://www.instagram.com/anthemmusicstudios/",
      "https://www.youtube.com/@anthemmusic4228"
    ],
    "description": description,
    "url": site,
    "telephone": "+1-469-500-9863",
    "email": "danbrady@anthemmusic.net",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "209 N Tennessee St",
      "addressLocality": "McKinney",
      "addressRegion": "TX",
      "postalCode": "75069",
      "addressCountry": "US"
    },
    "areaServed": ["McKinney", "Frisco", "Allen", "Prosper", "Plano", "Collin County"],
    "priceRange": "$$",
    "logo": site + "/anthem-logo.svg",
    "image": site + "/images/og-card-v2.jpg",
    "hasMap": "https://www.google.com/maps?q=209+N+Tennessee+St,+McKinney,+TX+75069",
    "knowsAbout": [
      "Guitar lessons", "Piano lessons", "Violin lessons", "Drum lessons",
      "Bass guitar lessons", "Ukulele lessons", "Voice lessons", "Brass lessons",
      "Music theory", "Group music classes", "Live music for events"
    ],
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Anthem Music offerings",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Private Music Lessons",
            "description": "One-on-one music lessons for all ages and instruments - guitar, piano, violin, drums, voice and more - in McKinney and across North Collin County, including a West McKinney home studio convenient to Frisco, Prosper and Plano."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Group Music Classes",
            "description": "PreK Music, Youth Group, and semester-based Homeschool music classes. The first class is free."
          }
        },
        {
          "@type": "Offer",
          "priceSpecification": {
            "@type": "PriceSpecification",
            "priceCurrency": "USD",
            "price": "150",
            "description": "Private parties $150/hour (two-hour minimum, $300); wedding ceremonies from $350."
          },
          "itemOffered": {
            "@type": "Service",
            "name": "Live Music for Events",
            "description": "Professional piano, violin, and guitar performers - solo or ensemble - for weddings, private parties, and special occasions."
          }
        }
      ]
    }
  })} />
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
</body>
</html>

<style is:global>
  body { display: flex; flex-direction: column; min-height: 100vh; }
  main { flex: 1; }
</style>
