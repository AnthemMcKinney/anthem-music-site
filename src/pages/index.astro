---
import Base from '../layouts/Base.astro';
import Shield from '../components/Shield.astro';
import Reviews from '../components/Reviews.astro';

// Offering 1 - private lessons, organized by instrument.
const lessons = [
  { name: "Guitar & Ukulele", href: "/guitar-lessons", blurb: "From first chords to lead lines - guitar, bass, ukulele, and banjo for every age." },
  { name: "Piano", href: "/piano-lessons", blurb: "Classical foundation, modern application. Reading, technique, and playing you'll actually enjoy." },
  { name: "Violin", href: "/violin-lessons", blurb: "Suzuki-informed strings instruction for young beginners through advancing players." },
  { name: "Drums & Percussion", href: "/drum-lessons", blurb: "Timing, technique, and groove - from first beats to full-kit control." },
  { name: "Brass", href: "/brass-lessons", blurb: "Private lessons on trumpet, french horn, and tuba - anything with three valves. Build tone, range, and technique." },
  { name: "Flute", href: "/schedule", blurb: "Flute for beginners through intermediate players - tone, breath support, reading, and technique." },
];

// Offering 2 - group classes (the homepage cutout; full detail lives on /programs).
const groupClasses = [
  { name: "PreK Music", ages: "Ages 2-4", href: "/kinder-music", blurb: "A playful first taste of music - rhythm, listening, and the framework every instrument is built on. Capped at 4." },
  { name: "Youth Group", ages: "Ages 4-6", href: "/youth-group", blurb: "An after-school group for kids who've outgrown PreK - rhythm, reading, and first instrument skills, learned together." },
  { name: "Homeschool Music Class", ages: "Ages 6-14", href: "/homeschool-music-lessons", blurb: "A real daytime class by semester, on real instruments - with fine arts credit documentation for older students." },
];

// Hero images - one is picked at random on each page load (see inline script in the hero).
const heroImages = [
  { src: "/images/hero.jpg", alt: "The Anthem Music studio in downtown McKinney - guitars, drums, and bright open windows" },
  { src: "/images/student-recital.jpg", alt: "A young Anthem Music student performing at the piano during a studio recital" },
  { src: "/images/kinder-circle.jpg", alt: "Dan Brady playing guitar with young children in a music class circle" },
  { src: "/images/christmas-recital.jpg", alt: "Dan Brady speaking to families gathered at an Anthem Music studio recital" },
];

const instructors = [
  { name: "Dan Brady", role: "Owner · Guitar & Piano", img: "/instructors/dan.jpg" },
  { name: "Britton Lowenthal", role: "Piano · Trumpet", img: "/instructors/britton.jpg" },
  { name: "Christine Dao", role: "Violin · Piano", img: "/instructors/christine.jpg" },
  { name: "Alexandra Smith", role: "Early Childhood Music & Theory", img: "/instructors/alex.jpg" },
  { name: "Elpis Jang", role: "Flute · Piano", img: "/instructors/elpis.jpg" },
  { name: "Lucas Henderson", role: "Guitar", img: "/instructors/lucas.jpg" },
];
---
<Base path="/">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Downtown McKinney · Music Lessons for All Ages</span>
        <h1>Where musicians are <em>formed</em>,<br class="h1-break" /> not just taught.</h1>
        <p class="lead">Guitar, piano, violin, drums, and brass for all ages - rooted in craft, mentorship, and a genuine love of music. Serious about musicianship, warm enough for the whole family.</p>
        <div class="hero-actions">
          <a href="/schedule" class="btn btn-primary">Book a Consultation</a>
          <a href="/programs" class="btn btn-outline">Explore Programs</a>
        </div>
        <div class="hero-trust">
          <span>★★★★★</span>
          <span>Trusted by McKinney &amp; Frisco families</span>
        </div>
      </div>
      <div class="hero-image-wrap">
        <img id="heroImg" src="/images/hero.jpg" alt={heroImages[0].alt} width="1600" height="1200" />
        <script is:inline define:vars={{ heroImages }}>
          // Pick a random hero on each load. Runs during parse, immediately after the
          // img tag, so the swap happens before the default src starts downloading.
          (function () {
            var pick = heroImages[Math.floor(Math.random() * heroImages.length)];
            var img = document.getElementById("heroImg");
            if (img && img.getAttribute("src") !== pick.src) {
              img.src = pick.src;
              img.alt = pick.alt;
            }
          })();
        </script>
        <div class="hero-badge">
          <Shield size={28} color="var(--orange)" />
          <div>
            <strong>15+ years</strong>
            <span>teaching experience</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="lessons">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What We Teach</span>
        <h2>Lessons and classes for every age</h2>
        <p class="lead mx-auto center">Every student is met where they are. No rigid curriculum - instruction is built around each player's goals, pace, and the way they learn best.</p>
      </div>
      <div class="lessons-grid">
        {lessons.map((l) => (
          <a href={l.href} class="lesson-card">
            <h3>{l.name}</h3>
            <p>{l.blurb}</p>
            <span class="lesson-link">Learn more →</span>
          </a>
        ))}
      </div>

      {/* Offering 2 cutout: group classes as a distinct, labeled block beneath
          the instrument grid - the full lineup lives on /programs. */}
      <div class="group-cutout">
        <div class="group-head">
          <span class="eyebrow" style="justify-content:center;">Group Classes</span>
          <h3>Prefer to learn in a group?</h3>
          <p class="group-sub">Small classes for younger musicians and homeschool families - the same fundamentals, learned together.</p>
        </div>
        <div class="group-grid">
          {groupClasses.map((c) => (
            <a href={c.href} class="group-card">
              <span class="g-ages">{c.ages}</span>
              <h4>{c.name}</h4>
              <p>{c.blurb}</p>
              <span class="lesson-link">Learn more →</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Reviews />

  <section class="section philosophy on-navy">
    <div class="container philosophy-inner">
      <div class="philosophy-copy">
        <span class="eyebrow">The Anthem Approach</span>
        <h2>We teach the <em>why</em>, not just the notes.</h2>
        <blockquote class="founder-quote">
          <p>&ldquo;When I first started playing, people would see me play a song and ask me to teach it to them - so I did. A week later they could get through the riff, but it never sounded right. I'd adjust their fingers, their timing, the pattern - and it still wouldn't stick, because I was only handing them notes. The framework underneath - the patterns woven through every song, the reasons a riff works - that's what I was skipping. If they wanted to play the instrument - not just one tune - I had to teach them the <em>how</em> and the <em>why</em>.&rdquo;</p>
          <cite>- Dan Brady, Owner</cite>
        </blockquote>
        <p>Every musician starts by copying - it's how we all learn. The players we copy are the innovators, and every one of them started out copying someone too. Copying builds the mechanics: hands, timing, vocabulary. But most programs stop there, teaching songs note by note, one at a time.</p>
        <p>Our foundational principle is teaching students the <em>why</em> underneath: why certain chords keep showing up in the songs they're learning, what actually makes a chord or a scale, how music is put together. That's what turns copying into creating - writing their own songs, playing along with anything, any time, by ear.</p>
        <p>And creating isn't the destination either. The circle closes when a student becomes the innovator - the one making something worth copying.</p>
        <a href="/about" class="btn btn-cream">Read Our Story</a>
      </div>
      <div class="philosophy-media">
        <img src="/images/teaching-kids.jpg" alt="Dan Brady teaching a group of young students at Anthem Music" loading="lazy" width="900" height="675" />
        <div class="philosophy-steps">
          <div class="pstep"><span>01</span><div><strong>Copy</strong><p>Learn from the players who came before you - build the mechanics, timing, and vocabulary.</p></div></div>
          <div class="pstep"><span>02</span><div><strong>Create</strong><p>Understand the why - chords, scales, patterns - and use those tools to make music that's yours.</p></div></div>
          <div class="pstep"><span>03</span><div><strong>Innovate</strong><p>Develop your own voice. Become the musician others learn from.</p></div></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Our Team</span>
        <h2>Instructors who mentor, not just instruct</h2>
        <p class="lead mx-auto center">Our teachers bring decades of combined experience across performance, classroom instruction, and real musicianship - and they genuinely care about the students they teach.</p>
      </div>
      <div class="instructor-grid">
        {instructors.map((i) => (
          <div class="instructor-card">
            <div class="instructor-photo">
              <img src={i.img} alt={i.name} loading="lazy" width="300" height="340" />
            </div>
            <h3>{i.name}</h3>
            <span class="instructor-role">{i.role}</span>
          </div>
        ))}
      </div>
      <div class="center" style="margin-top:2.5rem;">
        <a href="/instructors" class="btn btn-outline">Meet the Full Team</a>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container cta-inner">
      <div>
        <h2>Ready to start?</h2>
        <p>Book a consultation and we'll help you find the right instrument, the right instructor, and a clear plan to get going - no pressure, just a good first step.</p>
      </div>
      <a href="/schedule" class="btn btn-primary">Book a Consultation</a>
    </div>
  </section>
</Base>

<style>
  .hero { background: linear-gradient(180deg, var(--cream-soft) 0%, var(--white) 100%); padding: clamp(2.5rem, 6vw, 5rem) 0 clamp(3rem, 6vw, 5rem); }
  /* Asymmetric split: image dominant (right ~58%), copy left (~42%) */
  .hero-grid { display: grid; grid-template-columns: 42fr 58fr; gap: clamp(1.5rem, 3.5vw, 3rem); align-items: center; }
  .hero-copy h1 { font-size: clamp(2.1rem, 4.4vw, 3.3rem); margin-bottom: 1.5rem; }
  .hero-copy h1 em { color: var(--orange); font-style: italic; }
  .h1-break { display: inline; }
  .hero-copy .lead { max-width: 50ch; }
  .hero-actions { display: flex; gap: 1rem; margin-top: 2rem; flex-wrap: wrap; }
  .hero-trust { display: flex; align-items: center; gap: 0.7rem; margin-top: 2rem; font-size: 0.92rem; color: var(--gray); }
  .hero-trust span:first-child { color: var(--orange); letter-spacing: 2px; }
  .hero-image-wrap { position: relative; }
  .hero-image-wrap img { border-radius: 16px; width: 100%; height: auto; aspect-ratio: 4/3; object-fit: cover; box-shadow: 0 20px 50px rgba(13,31,60,.18); display: block; }
  .hero-badge { position: absolute; bottom: -18px; left: -18px; background: var(--white); border-radius: 12px; padding: 0.85rem 1.15rem; display: flex; align-items: center; gap: 0.7rem; box-shadow: 0 12px 30px rgba(13,31,60,.15); }
  .hero-badge strong { display: block; font-family: var(--font-display); color: var(--navy); font-size: 1.05rem; }
  .hero-badge span { font-size: 0.78rem; color: var(--gray); }

  .section-head { text-align: center; max-width: 640px; margin: 0 auto clamp(2.5rem, 5vw, 3.5rem); }
  .section-head .eyebrow { justify-content: center; }
  .section-head h2 { margin-bottom: 1rem; }

  .lessons-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .lesson-card { background: var(--white); border: 1px solid var(--line); border-radius: 14px; padding: 2rem; transition: transform .2s, box-shadow .2s, border-color .2s; display: flex; flex-direction: column; }
  .lesson-card:hover { transform: translateY(-4px); box-shadow: 0 16px 36px rgba(13,31,60,.1); border-color: transparent; }
  .lesson-card h3 { color: var(--navy); margin-bottom: 0.6rem; padding-top: 0.2rem; border-top: 3px solid var(--orange); display: inline-block; align-self: flex-start; padding-right: 1.5rem; }
  .lesson-card p { color: var(--gray); font-size: 0.95rem; flex: 1; }
  .lesson-link { color: var(--orange); font-weight: 600; font-size: 0.92rem; margin-top: 1rem; }

  /* Group Classes cutout (offering 2) - cream cards set it apart from the
     white instrument grid above, signaling a distinct, secondary offering. */
  .group-cutout { margin-top: clamp(2.2rem, 4.5vw, 3.4rem); }
  .group-head { text-align: center; max-width: 560px; margin: 0 auto 1.6rem; }
  .group-head h3 { color: var(--navy); font-size: clamp(1.3rem, 2.6vw, 1.65rem); margin: 0.35rem 0 0.5rem; }
  .group-sub { color: var(--gray); font-size: 0.98rem; }
  .group-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.3rem; }
  .group-card { background: var(--cream-soft); border: 1px solid var(--line); border-radius: 14px; padding: 1.5rem 1.6rem; display: flex; flex-direction: column; transition: transform .2s, box-shadow .2s, border-color .2s; }
  .group-card:hover { transform: translateY(-4px); box-shadow: 0 16px 36px rgba(13,31,60,.1); border-color: transparent; }
  .g-ages { color: var(--orange); font-weight: 700; font-size: 0.78rem; letter-spacing: 0.04em; text-transform: uppercase; }
  .group-card h4 { color: var(--navy); font-size: 1.15rem; margin: 0.35rem 0 0.6rem; }
  .group-card p { color: var(--gray); font-size: 0.92rem; flex: 1; margin: 0; }

  .philosophy { background: var(--navy); }
  .philosophy-inner { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .philosophy-copy p { color: var(--cream); opacity: 0.82; margin-bottom: 1.2rem; }
  .philosophy-copy p em { color: var(--orange); font-style: italic; font-weight: 700; }
  .founder-quote { margin: 0 0 1.4rem; padding: 1.2rem 1.4rem; border-left: 3px solid var(--orange); background: var(--navy-light); border-radius: 0 12px 12px 0; }
  .founder-quote p { font-family: var(--font-display); font-size: 1.05rem; line-height: 1.6; opacity: 0.95; margin-bottom: 0.6rem; }
  .founder-quote cite { color: var(--orange); font-style: normal; font-size: 0.88rem; font-weight: 600; }
  .philosophy-copy h2 { margin-bottom: 1.3rem; }
  .philosophy-media { display: flex; flex-direction: column; gap: 1.2rem; }
  .philosophy-media > img { border-radius: 14px; width: 100%; height: auto; object-fit: cover; box-shadow: 0 16px 40px rgba(0,0,0,.3); }
  .philosophy-steps { display: flex; flex-direction: column; gap: 0.9rem; }
  .pstep { display: flex; gap: 1.2rem; background: var(--navy-light); border-radius: 12px; padding: 1.3rem 1.5rem; }
  .pstep span { font-family: var(--font-display); font-size: 1.6rem; font-weight: 600; color: var(--orange); line-height: 1; }
  .pstep strong { color: var(--cream); font-family: var(--font-display); font-size: 1.2rem; display: block; margin-bottom: 0.3rem; }
  .pstep p { color: var(--cream); opacity: 0.75; font-size: 0.9rem; margin: 0; }

  .instructor-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .instructor-card { text-align: center; }
  .instructor-photo { border-radius: 14px; overflow: hidden; margin-bottom: 1rem; aspect-ratio: 3/3.4; background: var(--cream); }
  .instructor-photo img { width: 100%; height: 100%; object-fit: cover; }
  .instructor-card h3 { color: var(--navy); font-size: 1.25rem; margin-bottom: 0.2rem; }
  .instructor-role { color: var(--orange); font-size: 0.88rem; font-weight: 600; }

  .cta-band { background: var(--orange); padding: clamp(2.5rem, 5vw, 4rem) 0; }
  .cta-inner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
  .cta-band h2 { color: var(--white); margin-bottom: 0.5rem; }
  .cta-band p { color: var(--white); opacity: 0.92; max-width: 46ch; }
  .cta-band .btn-primary { background: var(--white); color: var(--orange-dark); }
  .cta-band .btn-primary:hover { background: var(--navy); color: var(--cream); }

  @media (max-width: 980px) {
    .lessons-grid, .group-grid { grid-template-columns: repeat(2, 1fr); }
    .instructor-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 860px) {
    /* Hero stacks: copy on top, image below - clean on phones */
    .hero-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .h1-break { display: none; }
    .hero-badge { left: auto; right: 16px; }
  }
  @media (max-width: 780px) {
    .philosophy-inner { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .lessons-grid, .group-grid { grid-template-columns: 1fr; }
    .instructor-grid { grid-template-columns: 1fr; }
  }
</style>
