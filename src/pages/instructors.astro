---
import Base from '../layouts/Base.astro';

const owner = {
  name: "Dan Brady",
  role: "Founder & Owner",
  tags: "Guitar & Piano · Bass, Ukulele, Banjo",
  img: "/instructors/dan.jpg",
  bio: "Dan is the founder of Anthem Music and one of its most versatile instructors - teaching both guitar and piano, along with bass, ukulele, and banjo. That range is rare: most instructors specialize in a single instrument family, but Dan's command of both fretted and keyed instruments gives his students a deeper, more connected understanding of how music actually works. A veteran with over 30 years of playing and 15-plus years of teaching, he brings a patient, meet-you-where-you-are approach that's earned him a loyal following of students and families. A father of seven and active in the McKinney community - including youth sports coaching and Dowell Middle School athletics - Dan has a special heart for working with students of all abilities, including those with special needs and the homeschool community. Before music became his full-time calling, he built a career in IT and project management, and that systems-minded discipline shows up in how thoughtfully he structures each student's growth.",
};

const team = [
  {
    name: "Britton Lowenthal",
    role: "Piano · Trumpet",
    img: "/instructors/britton.jpg",
    bio: "Britt is a classically trained pianist with over a decade of piano experience and seven years of trumpet performance. A standout young musician, she has served as Drum Major and holds leadership roles in her school's award-winning music programs. Britt combines strong classical fundamentals with genuine warmth in the studio, and she's especially skilled at building confidence in young and beginning players.",
  },
  {
    name: "Christine Dao",
    role: "Violin · Piano",
    img: "/instructors/christine.jpg",
    bio: "Christine brings a calm, encouraging presence and strong technical foundation to Anthem's strings program. She teaches violin and piano with a focus on solid fundamentals, careful listening, and steady progress - an approach that works beautifully for young beginners and advancing students alike. She believes every student can learn to play, and tailors her instruction to the way each individual learns best.",
  },
  {
    name: "Alexandra Smith",
    role: "Early Childhood Music & Theory",
    img: "/instructors/alex.jpg",
    bio: "Alexandra is an elementary music teacher who specializes in early childhood learning and music theory - someone who loves helping students understand how music actually works, not just memorize what to play. Her approach uses patterns, colors, shapes, numbers, and visual relationships to make musical ideas easier to see, hear, and understand. At Anthem she works with young and beginning students, helping them build a strong foundation along with real confidence and curiosity.",
  },
  {
    name: "Elpis Jang",
    role: "Flute · Piano",
    img: "/instructors/elpis.jpg",
    bio: "Elpis is a dedicated young flutist with eight years of experience, and has played in her school's top band since sixth grade. At Boyd she serves as a section leader and part of the band's leadership team - roles that have given her real practice at helping and encouraging other players. At Anthem she works mostly with younger and beginning flute and piano students, building strong fundamentals, confidence, and a genuine love of playing.",
  },
  {
    name: "Lucas Skidmore",
    role: "Guitar",
    img: "/instructors/lucas.jpg",
    bio: "Lucas teaches guitar at Anthem, from first chords through first songs. He's a capable young player with an easygoing, encouraging style that puts beginners at ease, and he genuinely enjoys helping newer students find their footing on the instrument.",
  },
];
---
<Base path="/instructors" title="Our Instructors | Anthem Music McKinney" description="Meet the instructors at Anthem Music in downtown McKinney - experienced, patient mentors teaching guitar, piano, violin, drums, brass, flute, and early-childhood music.">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow" style="justify-content:center;">Our Team</span>
      <h1 class="center">Meet our instructors</h1>
      <p class="lead mx-auto center">Mentors first, teachers always. Our instructors bring decades of combined experience - and a genuine investment in every student who walks through the door.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <article class="owner-card">
        <div class="owner-photo">
          <img src={owner.img} alt={owner.name} width="380" height="440" />
        </div>
        <div class="owner-content">
          <span class="owner-eyebrow">{owner.role}</span>
          <h2>{owner.name}</h2>
          <span class="bio-role">{owner.tags}</span>
          <p>{owner.bio}</p>
        </div>
      </article>

      <div class="team-grid">
        {team.map((i) => (
          <article class="team-card">
            <div class="team-photo">
              <img src={i.img} alt={i.name} loading="lazy" width="300" height="375" />
            </div>
            <div class="team-body">
              <h3>{i.name}</h3>
              <span class="bio-role">{i.role}</span>
              <p>{i.bio}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container cta-inner">
      <div>
        <h2>Find your instructor</h2>
        <p>Book a lesson and we'll match you with the right teacher for your instrument, age, and goals.</p>
      </div>
      <a href="/schedule" class="btn btn-primary">Book a Consultation</a>
    </div>
  </section>
</Base>

<style>
  .page-hero { background: var(--cream-soft); padding: clamp(2.5rem,5vw,4rem) 0; }
  .page-hero h1 { margin-bottom: 1rem; }

  /* Featured owner */
  .owner-card {
    display: grid; grid-template-columns: 320px 1fr; gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center; background: var(--cream-soft); border-radius: 20px;
    padding: clamp(1.5rem, 3vw, 2.5rem); margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .owner-photo { border-radius: 16px; overflow: hidden; aspect-ratio: 3/3.4; box-shadow: 0 16px 40px rgba(13,31,60,.14); }
  .owner-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .owner-eyebrow { color: var(--orange); font-weight: 700; font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .owner-content h2 { color: var(--navy); margin: 0.35rem 0 0.15rem; }
  .owner-content p { color: var(--gray); }
  .bio-role { color: var(--orange); font-weight: 600; font-size: 0.95rem; display: block; margin-bottom: 1rem; }

  /* Team grid */
  .team-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: clamp(1.2rem, 2.5vw, 1.8rem); }
  .team-card { background: var(--white); border: 1px solid var(--line); border-radius: 16px; overflow: hidden; display: flex; flex-direction: column; }
  .team-photo { aspect-ratio: 4/5; overflow: hidden; background: var(--cream); }
  .team-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .team-body { padding: 1.3rem 1.4rem 1.5rem; }
  .team-body h3 { color: var(--navy); margin: 0 0 0.15rem; font-size: 1.15rem; }
  .team-body .bio-role { margin-bottom: 0.7rem; font-size: 0.9rem; }
  .team-body p { color: var(--gray); font-size: 0.92rem; margin: 0; }

  @media (max-width: 820px) {
    .owner-card { grid-template-columns: 1fr; justify-items: center; text-align: center; }
    .owner-photo { max-width: 280px; }
    .bio-role, .owner-content p { text-align: left; }
    .team-grid { grid-template-columns: repeat(2,1fr); }
  }
  @media (max-width: 540px) {
    .team-grid { grid-template-columns: 1fr; }
  }

  .cta-band { background: var(--orange); padding: clamp(2.5rem,5vw,4rem) 0; }
  .cta-inner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
  .cta-band h2 { color: var(--white); margin-bottom: 0.5rem; }
  .cta-band p { color: var(--white); opacity: 0.92; max-width: 46ch; }
  .cta-band .btn-primary { background: var(--white); color: var(--orange-dark); }
  .cta-band .btn-primary:hover { background: var(--navy); color: var(--cream); }
</style>
