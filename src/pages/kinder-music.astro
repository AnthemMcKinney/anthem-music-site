---
import Base from '../layouts/Base.astro';

// PreK Music (ages 2-4). Built from the Primary Music course outline.
// URL stays /kinder-music for now (old inbound links / SEO); content is PreK-only.
const facts = [
  { k: "Ages", v: "2-4" },
  { k: "Format", v: "30-minute group time plus one-on-one instrument time" },
  { k: "Class size", v: "Capped at 4 students" },
  { k: "Enrollment", v: "By semester - fall, spring, and summer" },
];

const outcomes = [
  "Identify and repeat basic repeating patterns",
  "Keep basic 4/4 and 3/4 rhythm patterns",
  "Recognize the natural notes in music",
  "Hear the difference between major and minor chords and scales",
  "Notice the patterns and sequencing inside a song",
  "Keep rhythm and play simple scales with the instructor and other kids",
  "Sing and play fun, iconic songs",
];
---
<Base
  path="/kinder-music"
  title="PreK Music Class (Ages 2-4) | Anthem Music McKinney"
  description="A real music class for ages 2-4 in downtown McKinney. Rhythm, scales, and patterns taught through singing, movement, instruments, and play - the framework every instrument is built on. Small classes, capped at 4.">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow" style="justify-content:center;">PreK Music · Ages 2-4</span>
      <h1 class="center">Where the youngest musicians begin</h1>
      <p class="lead mx-auto center">Long before a child picks an instrument, they can learn the framework every instrument is built on - rhythm, scales, and patterns - through singing, movement, games, and play.</p>
      <div class="center" style="margin-top:1.8rem; display:flex; gap:0.8rem; justify-content:center; flex-wrap:wrap;">
        <a href="/book-a-class" class="btn btn-primary">See class times &amp; enroll →</a>
        <a href="/schedule" class="btn btn-outline">Book a Consultation</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>A real curriculum, not music playtime</h2>
      <p>Most classes for this age are sing-alongs. Ours is a structured curriculum that happens to be delivered through singing, dancing, instruments, coloring, and games. The goal is simple: channel a young child's natural interest in music into the framework they'll need the day they start a real instrument - whether that turns out to be piano, guitar, drums, or something like trumpet or cello years down the road.</p>
      <p>Those core skills - rhythm, the natural notes and scales, and how patterns combine to make a song - carry over to every instrument. Kids who come through PreK Music start their first instrument already feeling the beat, recognizing notes, and hearing patterns. That's a head start most beginners never get.</p>

      <img class="prek-photo" src="/images/kinder-circle.jpg" alt="Young children playing glockenspiels in a circle while an instructor plays guitar" loading="lazy" width="1400" height="932" />

      <h2>How a class runs</h2>
      <p>Each class opens in a group with a new song, then revisits the previous week's song - highlighting a specific idea like a rhythm pattern, a scale, or the way parts layer together. After about 25-30 minutes of group time, each child moves into a short one-on-one focus of their choice: a pattern or sequencing activity, some art, or their instrument of the moment - usually piano or ukulele - with the instructor alongside.</p>

      <div class="facts-grid">
        {facts.map((f) => (
          <div class="fact">
            <span class="fact-k">{f.k}</span>
            <span class="fact-v">{f.v}</span>
          </div>
        ))}
      </div>

      <h2>What they'll start to do</h2>
      <p>As the semester unfolds, most children begin to:</p>
      <ul class="outcome-list">
        {outcomes.map((o) => <li>{o}</li>)}
      </ul>

      <h2>Why it's capped at four</h2>
      <p>Two- to four-year-olds don't learn in a crowd. Keeping classes tiny means every child gets real one-on-one time at an instrument each week, and the instructor knows exactly where each of them is. We add new classes as interest grows rather than packing more kids into a room.</p>

      <h2>Getting started</h2>
      <p>Book a consultation and we'll place your child in a class that fits their age and readiness. Don't see a time that works? Tell us - we open new classes based on interest, and yours might be the one that starts the next.</p>
    </div>
  </section>

  <section class="cta-band">
    <div class="container cta-inner">
      <div>
        <h2>Give them the head start</h2>
        <p>See open class times and enroll online - or <a href="/schedule" style="color:var(--cream);text-decoration:underline;">book a consultation</a> first if you'd like to talk it through.</p>
      </div>
      <a href="/book-a-class" class="btn btn-primary">See class times &amp; enroll →</a>
    </div>
  </section>
</Base>

<style>
  .page-hero { background: var(--cream-soft); padding: clamp(2.5rem,5vw,4rem) 0; }
  .page-hero h1 { margin-bottom: 1rem; }
  .narrow { max-width: 760px; }
  .narrow h2 { margin: 2.5rem 0 1rem; }
  .narrow h2:first-child { margin-top: 0; }
  .narrow p { color: var(--gray); margin-bottom: 1.2rem; }
  .prek-photo { width: 100%; height: auto; border-radius: 14px; margin: 2rem 0 0.5rem; box-shadow: 0 14px 34px rgba(13,31,60,.12); }
  .facts-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 1rem; margin: 1.8rem 0; }
  .fact { background: var(--white); border: 1px solid var(--line); border-radius: 12px; padding: 1.1rem 1.3rem; }
  .fact-k { display: block; color: var(--orange); font-weight: 700; font-size: 0.78rem; letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 0.25rem; }
  .fact-v { color: var(--navy); font-weight: 500; font-size: 0.95rem; }
  .outcome-list { margin: 0 0 1.5rem; padding-left: 1.3rem; display: flex; flex-direction: column; gap: 0.5rem; }
  .outcome-list li { color: var(--gray); }
  .cta-band { background: var(--orange); padding: clamp(2.5rem,5vw,4rem) 0; }
  .cta-inner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
  .cta-band h2 { color: var(--white); margin-bottom: 0.5rem; }
  .cta-band p { color: var(--white); opacity: 0.92; max-width: 50ch; }
  .cta-band .btn-primary { background: var(--white); color: var(--orange-dark); }
  .cta-band .btn-primary:hover { background: var(--navy); color: var(--cream); }
  @media (max-width: 700px) { .facts-grid { grid-template-columns: 1fr; } }
</style>
