---
import Base from '../layouts/Base.astro';

// Two age bands, two sections each per week (four class times total). Times are set
// each semester - edit here when the schedule is confirmed.
const sections = [
  {
    name: "Foundations",
    ages: "Ages 6-9",
    desc: "First real music class for younger students. Rhythm and meter, reading notation, the keyboard as a map of how music works, and playing together as a group. Students rotate through instruments rather than committing to one.",
  },
  {
    name: "Musicianship",
    ages: "Ages 10-14",
    desc: "For older students ready for the real framework: keys and scales, chord construction, ear training, and playing along with other musicians. The theory is taught through playing, not worksheets.",
  },
];

const included = [
  { name: "45-minute weekly class", note: "One class per week through the semester, in the studio, on real instruments - not a lecture and not a sing-along." },
  { name: "Daytime, not evenings", note: "Classes run during the school day, so music fits into your week instead of competing with dinner and everything else." },
  { name: "Small by design", note: "Classes stay small enough that every student plays every week and nobody hides in the back." },
  { name: "Semester enrollment", note: "Fall, spring, and summer semesters, so you can plan music the same way you plan the rest of your year." },
];

const faqs = [
  {
    q: "Is this a class or private lessons?",
    a: "It's a real class. Students learn together in a group, on a curriculum that builds across the semester, the way a music class at a school would run - except it's in a working studio on real instruments. Private one-on-one lessons are a separate offering, and plenty of families do both.",
  },
  {
    q: "How much does it cost?",
    a: "The class is priced by the semester, with a discount for each additional child. Homeschool families often run several kids deep, so we keep it in a range that works across multiple students - we'll go over exact rates in your consultation.",
  },
  {
    q: "What if my child wants to focus on one instrument?",
    a: "Then private lessons are the better fit, and we teach those during the day too. Many students start in the class, discover the instrument that grabs them, and add a private lesson later. The class is the foundation; private lessons are the deep dive.",
  },
  {
    q: "Do we need an instrument at home?",
    a: "Not to start. Everything happens on studio instruments during class. Once a student gravitates toward something specific, having that instrument at home makes a real difference, and we'll help you figure out what to buy without overspending.",
  },
  {
    q: "Can music count toward a high school fine arts credit?",
    a: "Yes. We're happy to document class hours, repertoire, and skills covered so a parent can record fine arts credit on a transcript. Tell us at the start of the year and we'll keep the records as we go.",
  },
  {
    q: "Is your instruction religious or secular?",
    a: "Secular. There's no statement of faith to sign and no religious curriculum. Students are welcome to bring in worship music or any other repertoire they want to learn - we teach the music our students care about.",
  },
  {
    q: "Can I drop my student off, or should I stay?",
    a: "Either. Some parents use the class hour to run errands or work with another child; others stay in the studio. Both are completely normal here.",
  },
  {
    q: "Can you help our co-op or school start a music program?",
    a: "Sometimes, yes. We've built and taught music programs on-site at private schools before, usually one day a week. How much we can take on depends on studio scheduling, but we're always glad to talk it through - and if we can't teach it ourselves, we can often help you structure it or connect you with someone who can.",
  },
  {
    q: "What about band, orchestra, or ensemble experience?",
    a: "We're a private-instruction studio, so we don't run our own ensembles - but we're connected to trusted local groups for concert band, orchestra, and homeschool ensembles. If that's what your student needs, we'll help connect you.",
  },
];
---
<Base
  path="/homeschool-music-lessons"
  title="Homeschool Music Classes in McKinney, TX | Anthem Music"
  description="A real daytime music class for homeschool students in downtown McKinney. 45 minutes weekly, semester enrollment, sibling discounts. Ages 6-14, secular, fine arts credit documentation available.">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow" style="justify-content:center;">For Homeschool Families</span>
      <h1 class="center">Homeschool music classes in McKinney</h1>
      <p class="lead mx-auto center">A real music class that fits your school day - taught in a working studio, on real instruments, with a curriculum that builds across the semester.</p>
      <div class="center" style="margin-top:1.8rem;"><a href="/schedule" class="btn btn-primary">Book a Consultation</a></div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>A class, not lessons with a label on them</h2>
      <p>Plenty of studios will sell you a private lesson at 10am and call it a homeschool program. This isn't that. The Homeschool Music Class is a group class with its own curriculum, its own semester arc, and its own reason to exist: students learning music together, the way a school music class would work if the school had a real studio and professional instruments.</p>
      <p>Homeschool families have been part of Anthem from the beginning, and this is the program we built for them. It slots into your week as an enrichment block - one 45-minute class, during the day, on a schedule you can plan a semester around.</p>
      <p>What students get here is hard to get anywhere else at this age. Most kids don't touch a real instrument in a school setting until fourth or fifth grade, and when they do it's in a room of thirty or forty. Our classes run a semester at a time - fall, spring, and summer - in a working studio, on professional instruments, in a group small enough that every student plays every week and the instructor knows exactly where each of them is.</p>

      <div class="incl-list">
        {included.map((i) => (
          <div class="incl">
            <h3>{i.name}</h3>
            <p>{i.note}</p>
          </div>
        ))}
      </div>

      <h2>Two age groups</h2>
      <p>We run four class sections each week - two for younger students, two for older - so students learn alongside kids at a similar stage. Current semester times are confirmed at enrollment; book a consultation and we'll place your student in the right section.</p>
      <div class="section-grid">
        {sections.map((s) => (
          <div class="sec-card">
            <span class="sec-ages">{s.ages}</span>
            <h3>{s.name}</h3>
            <p>{s.desc}</p>
          </div>
        ))}
      </div>

      <h2>What it costs</h2>
      <p>We keep this class affordable on purpose. Homeschool families often run two, three, or four kids deep, and music shouldn't be the thing that gets cut because the per-child math stopped working - so it's priced to sit alongside your other activities rather than replace them, with a discount for each additional child. Enrollment runs by semester, and we'll walk through exact rates during your consultation.</p>

      <h2>Want to go deeper on one instrument?</h2>
      <p>The class is the foundation. For students who find their instrument and want to chase it, we teach private one-on-one lessons during daytime hours as well - piano, guitar, ukulele, drums, violin, brass, and flute. Many families do both: the class for musicianship and playing with others, a private lesson for depth. Ask about private rates during your consultation.</p>

      <h2>Fine arts credit for high schoolers</h2>
      <p>If your student needs a fine arts credit, we're happy to help you document it. We'll track hours, repertoire, and skills covered over the year and provide a summary you can use for your transcript records. Tell us at the start and we'll keep the records as we go - no reconstructing a year of music in May.</p>

      <h2>Music programs for co-ops &amp; private schools</h2>
      <p>Before Anthem had a storefront, our founder spent a couple of years building and teaching music programs on-site at private schools - designing each one from scratch, then showing up every week to teach it. Every program was different: different ages, different schedules, different goals. That's still how we approach it.</p>
      <p>When our calendar allows, we partner with co-ops, private schools, and homeschool groups to teach on-site, help build a curriculum, or just offer guidance on getting a program started. If we can't take it on ourselves, we can usually connect you with someone who can.</p>
      <p>Budgets in this space vary widely, and these arrangements rarely look like a standard lesson invoice - we're flexible about how they're structured. If you're exploring the idea, we'd love to hear what you have in mind.</p>

      <h2>Common questions</h2>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  })} />

  <section class="cta-band">
    <div class="container cta-inner">
      <div>
        <h2>Let's find your family's spot</h2>
        <p>Music is one of the few subjects children pursue simply because they love it - and those are usually the lessons that stay with them for life. Book a consultation and we'll talk through class times, age groups, and what fits your family.</p>
      </div>
      <a href="/schedule" class="btn btn-primary">Book a Consultation</a>
    </div>
  </section>
</Base>

<style>
  .page-hero { background: var(--cream-soft); padding: clamp(2.5rem,5vw,4rem) 0; }
  .page-hero h1 { margin-bottom: 1rem; }
  .narrow { max-width: 760px; }
  .narrow h2 { margin: 2.5rem 0 1rem; }
  .narrow h2:first-child { margin-top: 0; }
  .narrow p { color: var(--gray); margin-bottom: 1.2rem; }
  .narrow p strong { color: var(--navy); }
  .narrow a { color: var(--orange); font-weight: 500; }

  .incl-list { display: grid; grid-template-columns: repeat(2,1fr); gap: 1rem; margin: 1.8rem 0; }
  .incl { background: var(--white); border: 1px solid var(--line); border-radius: 12px; padding: 1.3rem 1.5rem; }
  .incl h3 { color: var(--navy); font-size: 1.05rem; margin-bottom: 0.35rem; }
  .incl p { color: var(--gray); font-size: 0.94rem; margin: 0; }

  .section-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin: 1.8rem 0; }
  .sec-card { background: var(--white); border: 1px solid var(--line); border-radius: 12px; padding: 1.7rem; }
  .sec-ages { color: var(--orange); font-weight: 700; font-size: 0.86rem; letter-spacing: 0.04em; text-transform: uppercase; }
  .sec-card h3 { color: var(--navy); font-size: 1.25rem; margin: 0.4rem 0 0.7rem; }
  .sec-card p { color: var(--gray); font-size: 0.94rem; margin: 0; }

  .price-box { background: var(--navy); border-radius: 14px; padding: 1.9rem 2rem; margin: 1.8rem 0; }
  .price-head { display: flex; align-items: baseline; gap: 0.7rem; }
  .price-num { font-family: var(--font-display); font-size: 2.6rem; font-weight: 600; color: var(--cream); line-height: 1; }
  .price-unit { color: var(--gray-light); font-size: 0.95rem; }
  .price-note { color: var(--orange); font-weight: 600; font-size: 0.92rem; margin: 0.7rem 0 0; }
  .price-family { list-style: none; margin: 1.3rem 0 0; padding: 1.2rem 0 0; border-top: 1px solid var(--navy-light); display: flex; flex-direction: column; gap: 0.6rem; }
  .price-family li { display: flex; justify-content: space-between; gap: 1rem; }
  .price-family strong { color: var(--cream); font-weight: 500; font-size: 0.96rem; }
  .price-family span { color: var(--gray-light); font-size: 0.96rem; }

  .faq-list { display: flex; flex-direction: column; gap: 0.7rem; margin: 1.6rem 0; }
  .faq-item { background: var(--cream-soft); border-radius: 12px; padding: 1.1rem 1.4rem; }
  .faq-item summary { color: var(--navy); font-weight: 600; cursor: pointer; font-size: 1rem; }
  .faq-item p { color: var(--gray); font-size: 0.95rem; margin: 0.8rem 0 0; }

  .cta-band { background: var(--orange); padding: clamp(2.5rem,5vw,4rem) 0; }
  .cta-inner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
  .cta-band h2 { color: var(--white); margin-bottom: 0.5rem; }
  .cta-band p { color: var(--white); opacity: 0.92; max-width: 52ch; }
  .cta-band .btn-primary { background: var(--white); color: var(--orange-dark); }
  .cta-band .btn-primary:hover { background: var(--navy); color: var(--cream); }

  @media (max-width: 700px) {
    .incl-list, .section-grid { grid-template-columns: 1fr; }
  }
</style>
