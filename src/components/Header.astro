---
// Primary nav. Instructors now lives under the About dropdown (it's part of "who we
// are"), which frees a top-level slot for Free Tuner without crowding the bar.
const portalUrl = "/student-login";
const aboutLinks = [
  { label: "About Us", href: "/about" },
  { label: "Our Instructors", href: "/instructors" },
  { label: "FAQ", href: "/faq" },
];
const bookLinks = [
  { label: "Private Lessons", href: "/schedule", sub: "Free consultation" },
  { label: "Group Classes", href: "/book-a-class", sub: "First class free" },
  { label: "Live Music for Events", href: "/book-a-performer", sub: "Parties & weddings" },
];
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Anthem Music home">
      <img src="/anthem-logo.svg" alt="Anthem Music" class="brand-logo" width="44" height="48" />
      <span class="brand-text">Anthem<span class="brand-sub">Music</span></span>
    </a>

    <nav class="nav-desktop" aria-label="Main navigation">
      <a href="/programs">Programs</a>

      <div class="nav-dd nav-about">
        <button class="nav-dd-trigger" aria-haspopup="true" aria-expanded="false">About <span class="caret" aria-hidden="true">▾</span></button>
        <div class="book-menu about-menu" role="menu" aria-label="About Anthem">
          {aboutLinks.map((a) => <a href={a.href} role="menuitem">{a.label}</a>)}
        </div>
      </div>

      <a href="/blog">Blog</a>
      <a href="/contact">Contact</a>
      <a href="/free-tuner" class="nav-tuner">Free Tuner</a>

      <a href={portalUrl} class="btn parent-login">Student Login</a>

      <div class="nav-dd nav-book" id="navBook">
        <button class="btn btn-primary nav-cta" aria-haspopup="true" aria-expanded="false">
          Book <span class="caret" aria-hidden="true">▾</span>
        </button>
        <div class="book-menu" role="menu" aria-label="Booking options">
          {bookLinks.map((b) => (
            <a href={b.href} role="menuitem"><strong>{b.label}</strong><span>{b.sub}</span></a>
          ))}
          <a href="/get-started" role="menuitem" class="book-menu-all">See all options →</a>
        </div>
      </div>
    </nav>

    <button class="nav-toggle" aria-label="Open menu" aria-expanded="false" id="navToggle">
      <span></span><span></span><span></span>
    </button>
  </div>

  <nav class="nav-mobile" id="navMobile" aria-label="Mobile navigation">
    <a href="/programs">Programs</a>
    <a href="/about">About Us</a>
    <a href="/instructors">Our Instructors</a>
    <a href="/faq">FAQ</a>
    <a href="/blog">Blog</a>
    <a href="/contact">Contact</a>
    <a href="/free-tuner">Free Tuner</a>
    <a href={portalUrl} class="btn parent-login">Student Login</a>
    <span class="mobile-book-label">Book</span>
    {bookLinks.map((b) => <a href={b.href} class="mobile-book-link">{b.label}</a>)}
    <a href="/get-started" class="btn btn-primary">Get Started</a>
  </nav>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 100;
    background: rgba(255,255,255,0.96);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    display: flex; align-items: center; justify-content: space-between;
    height: 74px;
  }
  .brand { display: flex; align-items: center; gap: 0.6rem; }
  .brand-logo { height: 48px; width: auto; }
  .brand-text {
    font-family: var(--font-display); font-weight: 600; font-size: 1.5rem;
    color: var(--navy); line-height: 1; letter-spacing: -0.02em;
  }
  .brand-sub { color: var(--orange); margin-left: 0.3rem; }
  .nav-desktop { display: flex; align-items: center; gap: 1.25rem; }
  .nav-desktop > a:not(.parent-login) {
    color: var(--navy); font-weight: 500; font-size: 0.98rem; position: relative;
  }
  .nav-desktop > a:not(.parent-login):hover { color: var(--orange); }
  .nav-tuner { color: var(--orange-dark) !important; font-weight: 600 !important; }
  .nav-cta { padding: 0.6rem 1.3rem; font-size: 0.95rem; }
  .nav-cta .caret, .nav-dd-trigger .caret { font-size: 0.8em; margin-left: 0.15rem; }

  /* Parent Login - deliberately yellow, outside the navy/orange brand palette. */
  .parent-login {
    background: #F6C544; color: var(--navy);
    padding: 0.6rem 1.2rem; font-size: 0.9rem; font-weight: 600; border: 2px solid transparent;
  }
  .parent-login:hover { background: #E9B52E; color: var(--navy); transform: translateY(-2px); }

  /* Shared dropdown (About + Book) */
  .nav-dd { position: relative; display: inline-flex; align-items: center; }
  .nav-dd-trigger {
    background: none; border: 0; cursor: pointer; font: inherit;
    color: var(--navy); font-weight: 500; font-size: 0.98rem;
    display: inline-flex; align-items: center;
  }
  .nav-dd-trigger:hover { color: var(--orange); }
  .book-menu {
    position: absolute; top: calc(100% + 10px); right: 0; min-width: 248px;
    display: none; flex-direction: column;
    background: var(--white); border: 1px solid var(--line); border-radius: 12px;
    box-shadow: 0 16px 40px rgba(13,31,60,.16); padding: 0.5rem; z-index: 200;
  }
  .about-menu { left: 0; right: auto; min-width: 190px; }
  .book-menu::before { content: ""; position: absolute; top: -16px; right: 0; left: 0; height: 16px; }
  .nav-dd:hover .book-menu, .nav-dd:focus-within .book-menu, .book-menu.open { display: flex; }
  .book-menu a { display: block; padding: 0.6rem 0.8rem; border-radius: 8px; color: var(--navy); font-weight: 500; }
  .book-menu a strong { display: block; font-size: 0.95rem; font-weight: 600; }
  .book-menu a span { display: block; font-size: 0.78rem; color: var(--gray); }
  .book-menu a:hover, .book-menu a:focus-visible { background: var(--cream-soft); outline: none; }
  .book-menu a:hover strong, .about-menu a:hover { color: var(--orange-dark); }
  .book-menu-all { margin-top: 0.3rem; border-top: 1px solid var(--line); color: var(--orange) !important; font-weight: 600; font-size: 0.9rem; padding-top: 0.7rem !important; }

  .nav-toggle { display: none; flex-direction: column; gap: 5px; background: none; border: none; cursor: pointer; padding: 8px; }
  .nav-toggle span { width: 26px; height: 2px; background: var(--navy); transition: .3s; }
  .nav-mobile { display: none; flex-direction: column; padding: 1rem var(--pad) 1.5rem; gap: 0.5rem; border-top: 1px solid var(--line); background: var(--white); }
  .nav-mobile a:not(.btn) { color: var(--navy); font-weight: 500; padding: 0.6rem 0; }
  .nav-mobile.open { display: flex; }
  .mobile-book-label { margin-top: 0.4rem; padding-top: 0.6rem; border-top: 1px solid var(--line); color: var(--gray); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .nav-mobile a.mobile-book-link { padding-left: 0.6rem; }

  @media (max-width: 1220px) {
    .nav-desktop { display: none; }
    .nav-toggle { display: flex; }
  }
</style>

<script>
  const toggle = document.getElementById('navToggle');
  const mobile = document.getElementById('navMobile');
  toggle?.addEventListener('click', () => {
    const open = mobile?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(open));
  });

  // Generic dropdown handling for both About and Book (hover works via CSS for mouse).
  const dds = document.querySelectorAll('.nav-dd');
  function closeAll(except) {
    dds.forEach((dd) => {
      const m = dd.querySelector('.book-menu');
      if (m && m !== except) {
        m.classList.remove('open');
        dd.querySelector('button')?.setAttribute('aria-expanded', 'false');
      }
    });
  }
  dds.forEach((dd) => {
    const trigger = dd.querySelector('button');
    const menu = dd.querySelector('.book-menu');
    trigger?.addEventListener('click', (e) => {
      e.preventDefault();
      const open = menu?.classList.toggle('open');
      trigger.setAttribute('aria-expanded', String(open));
      closeAll(menu);
    });
  });
  document.addEventListener('click', (e) => {
    let inside = false;
    dds.forEach((dd) => { if (dd.contains(e.target as Node)) inside = true; });
    if (!inside) closeAll(null);
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll(null); });
</script>
