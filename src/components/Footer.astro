---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <span class="footer-logo">Anthem<span>Music</span></span>
      <p>A McKinney music studio with two locations - where students of all ages are trained, encouraged, and challenged to grow in real musicianship.</p>
      <div class="footer-social" aria-label="Social links">
        <a href="https://www.facebook.com/anthemmusicstudios" aria-label="Facebook">Facebook</a>
        <a href="https://www.instagram.com/anthemmusicstudios/" aria-label="Instagram">Instagram</a>
        <a href="https://www.youtube.com/@anthemmusic4228" aria-label="YouTube">YouTube</a>
      </div>
    </div>

    <div class="footer-col">
      <h4>Programs</h4>
      <a href="/guitar-lessons">Guitar &amp; Ukulele</a>
      <a href="/piano-lessons">Piano</a>
      <a href="/drum-lessons">Drums &amp; Percussion</a>
      <a href="/violin-lessons">Violin</a>
      <a href="/brass-lessons">Brass</a>
      <a href="/kinder-music">PreK Music</a>
      <a href="/youth-group">Youth Group</a>
      <a href="/homeschool-music-lessons">Homeschool Music</a>
      <a href="/adaptive-music-lessons">Adaptive Lessons</a>
    </div>

    <div class="footer-col">
      <h4>Studio</h4>
      <a href="/instructors">Instructors</a>
      <a href="/about">About Us</a>
      <a href="/faq">FAQ</a>
      <a href="/blog">Blog</a>
      <a href="/tuner/" target="_blank" rel="noopener">Tuner, Metronome &amp; Chords ↗</a>
      <a href="/careers">Teach at Anthem</a>
      <a href="/schedule">Book a Consultation</a>
      <a href="/book-a-class">Book a Class</a>
      <a href="/book-a-performer">Live Music for Events</a>
      <a href="/contact">Contact</a>
    </div>

    <div class="footer-col">
      <h4>Locations</h4>
      <p class="footer-contact footer-locations">
        <span class="loc-head">Two studios in McKinney</span>
        <span class="loc-line"><b>Downtown McKinney</b><br/>Virginia &amp; N Tennessee St</span>
        <span class="loc-line"><b>West McKinney</b><br/>Custer &amp; Eldorado</span>
        <span class="loc-note">We'll confirm your studio and the exact address when you book - the West McKinney studio is handy for Frisco, Prosper &amp; Plano families.</span>
      </p>
      <p class="footer-contact footer-reach">
        <a href="tel:+14695009863">(469) 500-9863</a><br/>
        <a href="mailto:danbrady@anthemmusic.net">danbrady@anthemmusic.net</a>
      </p>
      <p class="footer-areas">
        <span>Music lessons in:</span>
        <a href="/music-lessons-frisco">Frisco</a> · <a href="/music-lessons-prosper">Prosper</a> · <a href="/music-lessons-plano">Plano</a> · <a href="/music-lessons-allen">Allen</a>
      </p>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <span>© {year} Anthem Music LLC. All rights reserved.</span>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--navy); color: var(--cream); margin-top: auto; }
  .footer-grid {
    display: grid; grid-template-columns: 2fr 1fr 1fr 1.3fr; gap: 2.5rem;
    padding-top: 4rem; padding-bottom: 3rem;
  }
  .footer-logo {
    font-family: var(--font-display); font-weight: 600; font-size: 1.5rem;
    color: var(--cream); display: block; margin-bottom: 1rem;
  }
  .footer-logo span { color: var(--orange); margin-left: 0.3rem; }
  .footer-brand p { color: var(--gray-light); font-size: 0.95rem; max-width: 34ch; }
  .footer-social { display: flex; gap: 1.2rem; margin-top: 1.2rem; }
  .footer-social a { color: var(--cream); font-size: 0.9rem; font-weight: 500; }
  .footer-social a:hover { color: var(--orange); }
  .footer-col h4 { color: var(--cream); font-size: 1.05rem; margin-bottom: 1rem; }
  .footer-col a { display: block; color: var(--gray-light); font-size: 0.93rem; padding: 0.3rem 0; }
  .footer-col a:hover { color: var(--orange); }
  .footer-contact { color: var(--gray-light); font-size: 0.93rem; line-height: 1.9; }
  .footer-contact a { color: var(--gray-light); }
  .footer-contact a:hover { color: var(--orange); }
  .footer-locations { line-height: 1.5; margin-bottom: 1rem; }
  .loc-head { display: block; color: var(--cream); font-weight: 600; margin-bottom: 0.6rem; }
  .loc-line { display: block; margin-bottom: 0.5rem; }
  .loc-line b { color: var(--cream); font-weight: 600; }
  .loc-note { display: block; margin-top: 0.5rem; font-size: 0.8rem; color: var(--gray-light); line-height: 1.5; }
  .footer-reach { line-height: 1.8; }
  .footer-areas { margin-top: 1rem; font-size: 0.82rem; color: var(--gray-light); line-height: 1.7; }
  .footer-areas span { display: block; color: var(--gray-light); margin-bottom: 0.2rem; }
  .footer-areas a { color: var(--gray-light); }
  .footer-areas a:hover { color: var(--orange); }
  .footer-bottom { border-top: 1px solid var(--navy-light); padding: 1.5rem 0; }
  .footer-bottom span { color: var(--gray-light); font-size: 0.85rem; }

  @media (max-width: 860px) {
    .footer-grid { grid-template-columns: 1fr 1fr; gap: 2rem; }
    .footer-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 500px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>
